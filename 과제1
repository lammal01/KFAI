import pandas as pd

# 1. 표에 들어갈 데이터
data = [
    {
        "차트 내용": "소비자물가지수(CPI) 추이",
        "원천 출처": "통계청 국가통계포털(KOSIS)",
        "링크": "https://kosis.kr",
        "기준 날짜": "2026-09",
        "갱신 주기": "월별",
        "무료/유료": "무료",
        "수집 방법": "1 (KOSIS 공유서비스 OpenAPI)",
    },
    {
        "차트 내용": "원/달러 환율 추이",
        "원천 출처": "한국은행 경제통계시스템(ECOS)",
        "링크": "https://ecos.bok.or.kr",
        "기준 날짜": "2026-10",
        "갱신 주기": "일별",
        "무료/유료": "무료",
        "수집 방법": "1 (ECOS Open API)",
    },
]

# 2. 표(DataFrame)로 만들기
df = pd.DataFrame(data)
print(df)

# 3. CSV 파일로 저장 (엑셀에서 한글 안 깨지게 utf-8-sig)
df.to_csv("data_sources.csv", index=False, encoding="utf-8-sig")

# 4. 깃허브에서 표로 보이는 마크다운 파일로 저장
lines = []
lines.append("| " + " | ".join(df.columns) + " |")
lines.append("|" + "---|" * len(df.columns))
for _, row in df.iterrows():
    cells = []
    for col in df.columns:
        value = str(row[col])
        if col == "링크":
            value = f"[링크]({value})"   # 클릭 가능한 링크로
        cells.append(value)
    lines.append("| " + " | ".join(cells) + " |")

with open("data_sources.md", "w", encoding="utf-8") as f:
    f.write("# 데이터 수집 대상 목록\n\n")
    f.write("\n".join(lines))

print("data_sources.csv, data_sources.md 저장 완료")
